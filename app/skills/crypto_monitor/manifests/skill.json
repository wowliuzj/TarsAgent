{
    "name": "crypto_monitor",
    "version": "1.0.0",
    "description": "监控加密货币（如 BTC, ETH）的实时价格。",
    "runtime": "python",
    "main": "src/executor.py",
    "parameters": {
        "type": "object",
        "properties": {
            "symbol": {
                "type": "string",
                "description": "交易对名称，必须是大写，例如 'BTCUSDT' 或 'ETHUSDT'。",
                "pattern": "^[A-Z0-9]+$"
            }
        },
        "required": ["symbol"]
    }
}
