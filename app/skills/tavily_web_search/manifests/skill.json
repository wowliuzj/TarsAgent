{
    "name": "web_search",
    "version": "1.0.0",
    "description": "执行全网搜索以获取实时新闻、事实或背景信息。",
    "runtime": "python",
    "main": "src/executor.py",
    "parameters": {
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "description": "搜索关键词或短语。"
            },
            "max_results": {
                "type": "integer",
                "description": "返回的结果数量，默认 5。",
                "default": 5
            }
        },
        "required": ["query"]
    }
}
