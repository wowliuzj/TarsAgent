# --- LLM 配置 ---
# 如果直接使用 LiteLLM 的 Gemini 支持，只需填写此项:
GOOGLE_API_KEY="your_google_api_key"

# 如果通过 OpenAI 兼容代理访问 (例如 OneAPI 或 Google 官方的 OpenAI 兼容端点):
# OPENAI_API_KEY=YOUR_KEY
# OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/

# 模型定义 (LiteLLM 格式)
MODEL_NAME=llm_model_name

#tavily.com api key
TAVILY_API_KEY=tvly-你的API密钥

# --- 数据库配置 ---
# 这里的 'db' 是 docker-compose.yml 中定义的数据库服务名
DATABASE_URL=postgresql://tars:tars_pass@db:5432/tars_db

# --- RAG (长期记忆) 配置 ---
# 默认使用 Google 的 gemini/gemini-embedding-2 (3072维)
EMBEDDING_MODEL=gemini/gemini-embedding-2
EMBEDDING_DIM=3072

# --- 其他配置 ---
# Agent 最大思考步数 (防止无限循环)
MAX_STEPS=20
# Agent 工作目录 (容器内部路径)
WORKSPACE_DIR=data
# 系统代理
ALL_PROXY=http://127.0.0.1:7890