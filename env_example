# --- LLM API Keys ---
# Google Gemini Key
GOOGLE_API_KEY="your_google_api_key_here"

# OpenAI Key
OPENAI_API_KEY="your_openai_api_key_here"

# (可选) OpenAI 兼容代理地址，如果直连官方则保持注释
# OPENAI_API_BASE=https://api.openai.com/v1

# --- 模型定义 (必须包含提供商前缀，如 openai/ 或 gemini/) ---
# 主推理模型 (推荐: openai/gpt-4o, openai/gpt-4o-mini)
MODEL_NAME=openai/gpt-5-mini

# 长期记忆向量模型 (推荐保留 gemini/ 以兼容旧数据)
EMBEDDING_MODEL=gemini/gemini-embedding-2
# 向量维度 (Gemini 2 默认为 3072)
EMBEDDING_DIM=3072

# --- 其他服务 ---
# tavily.com api key (用于联网搜索技能)
TAVILY_API_KEY=your_tavily_key_here

# --- 数据库配置 ---
DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# --- Agent 行为配置 ---
# 任务执行的最大步骤数限制
MAX_STEPS=50
# 执行器在发生错误或遭拒时的最大重试次数
MAX_EXECUTOR_RETRIES=3
# 规划器在规划出错时的最大重试次数
MAX_PLANNER_RETRIES=2
# 工作区文件存储根目录
WORKSPACE_DIR=data
# 网络代理配置 (用于沙盒和外部网络通信)
ALL_PROXY=http://127.0.0.1:7890

# --- 安全置信度阈值配置 ---
# 普通工具自评分安全置信阈值 (默认 0.75)
BASE_CONFIDENCE_THRESHOLD=0.75
# 终端执行命令安全置信值 (默认 0.85)
TERMINAL_CONFIDENCE_THRESHOLD=0.85
# tool_call_finished 的输出预览长度 (默认 280)
TRACE_TOOL_PREVIEW_CHARS=280
# L1 单步任务是否启用 Auditor 快速审计旁路 (默认 true)
AUDITOR_L1_FAST_PATH_ENABLED=true
# trace 事件写入目的地: jsonl / db / both (默认 both)
TRACE_SINK_MODE=both

# --- Tiered Reasoning (仿生算力分级) ---
# 是否启用 Tier 路由
TIER_ROUTING_ENABLED=false
# Tier 对应模型池
TIER_MODEL_LOW=openai/gpt-5-mini
TIER_MODEL_MID=openai/gpt-5-mini
TIER_MODEL_HIGH=openai/gpt-5
TIER_MODEL_ULTRA=openai/gpt-5
# 各角色默认 Tier
TIER_DEFAULT_PLANNER=mid
TIER_DEFAULT_EXECUTOR=mid
TIER_DEFAULT_AUDITOR=high
TIER_DEFAULT_REFLECT=mid
# Executor 的 L1~L6 覆盖 Tier（可按需调整）
TIER_EXECUTOR_L1=low
TIER_EXECUTOR_L2=low
TIER_EXECUTOR_L3=mid
TIER_EXECUTOR_L4=mid
TIER_EXECUTOR_L5=high
TIER_EXECUTOR_L6=ultra
# 自适应升级阈值：executor 重试达到阈值后自动升一档
TIER_MAX_RETRIES_BEFORE_UPGRADE=2
# 单次运行 token 预算（0 表示关闭预算降级）
TIER_BUDGET_TOKENS_PER_RUN=0
# 超预算后降级到的 Tier
TIER_BUDGET_DOWNGRADE_TIER=low

# --- LLM 连接稳定性容错 ---
# 主模型连接失败时可回退到备用模型（为空则不启用回退）
MODEL_FALLBACK_NAME=
# 单模型最大重试次数（含首次）
LLM_MAX_RETRIES=2
# 重试基础退避毫秒
LLM_RETRY_BASE_DELAY_MS=800
