        "directory": {
          "default": ".",
          "title": "Directory",
          "type": "string"
        }
      },
      "title": "list_filesArguments",
      "type": "object"
    }
  },
  {
    "name": "run_terminal_command",
    "description": "在项目根目录下执行终端命令。",
