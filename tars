#!/bin/bash

# 确保在项目根目录下运行
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# 1. 后台启动数据库 (如果没启动的话)
docker-compose up -d db

# 2. 检查并激活虚拟环境 (可选，建议你自己手动创建 venv)
if [ -d "venv" ]; then
    source venv/bin/activate
fi

# 3. 直接运行本体
# 使用 python3 -m app.main 确保模块导入路径正确
python3 -m app.main "$@"
